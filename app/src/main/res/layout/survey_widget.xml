<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" android:id="@+id/survey_root" android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="vertical" android:gravity="center_vertical" android:padding="10dp" android:background="#1b2434">
    <TextView android:id="@+id/survey_title" android:layout_width="match_parent" android:layout_height="wrap_content" android:textColor="#c6e4ec" android:textSize="12sp" />
    <TextView android:id="@+id/survey_value" android:layout_width="match_parent" android:layout_height="wrap_content" android:textColor="#ffffff" android:textSize="20sp" />
    <ProgressBar android:id="@+id/survey_bar" style="?android:attr/progressBarStyleHorizontal" android:layout_width="match_parent" android:layout_height="6dp" />
    <TextView android:id="@+id/survey_time" android:layout_width="match_parent" android:layout_height="wrap_content" android:textColor="#d2dce6" android:textSize="10sp" />
</LinearLayout>

